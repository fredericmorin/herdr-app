@@ -0,0 +1,27 @@
+// A space row's Claude Code sessions: one icon per agent in the space whose program is Claude,
+// in the theme's blocked color while it needs you, its done color once it finished unseen,
+// dimmed while it's idle.
+import { image, svg } from "gpui-kit";
+import { h_flex } from "gpui-base";
+import { agents } from "herdr";
+
+const SIZE = 12;
+
+// An array, empty for a space without one, so such a row gets no extra gap.
+export function claudeIcons(space, t) {
+  const list = agents().filter((a) => a.space === space && a.program?.key === "claude" && a.program.icon);
+  if (!list.length) return [];
+  return [h_flex().flex_none().gap(3).items_center()
+    .children(list.map((a) => icon(a, t)))];
+}
+
+function icon(a, t) {
+  // blocked and done recolor the icon (drawn as one color); the others keep the program's look.
+  if (a.status === "blocked" || a.status === "done") {
+    return svg(a.program.icon).size(SIZE).flex_none().text_color(t[a.status]);
+  }
+  const el = a.program.tint
+    ? svg(a.program.icon).size(SIZE).flex_none().text_color(t.foreground)
+    : image(a.program.icon).w(SIZE).h(SIZE).flex_none();
+  return el.when(a.status === "idle", (e) => e.opacity(0.4));
+}
