diff -ruN a/mods/spaces/pr-status.js b/mods/spaces/pr-status.js
--- a/mods/spaces/pr-status.js	1969-12-31 19:00:00
+++ b/mods/spaces/pr-status.js	2026-11-23 23:26:14
@@ -0,0 +1,80 @@
+// The badge a space row shows for its branch's pull request (GitHub) or merge request
+// (GitLab). The status hub (mods/status-hub) finds them and publishes `status.reviews`;
+// this only draws an entry.
+// Adapted from Better Sidebar's git/pr-status.js (github.com/munza/herdr-mods,
+// Copyright 2026 Tawsif Aqib, Apache License 2.0).
+import { div, svg } from "gpui-kit";
+import { h_flex } from "gpui-base";
+import { window } from "herdr";
+
+// Cmd-click on macOS, Ctrl-click elsewhere, opens the PR; a plain click is the row's.
+const linkClick = (event) =>
+  window().platform === "macos"
+    ? Boolean(event.modifiers?.platform)
+    : Boolean(event.modifiers?.control || event.modifiers?.platform);
+
+// GitLab numbers its merge requests !N, GitHub its pull requests #N.
+const sign = (item) => (item.host === "gitlab" ? "!" : "#");
+
+// An open or draft one's CI, beside its number: a ring while it runs, a dot once it passed or
+// failed. The icon's color stays the review state; ready to merge already says CI passed (✓).
+function ciMark(item, t) {
+  if (item.look.ready || (item.state !== "open" && item.state !== "draft")) return null;
+  if (item.ci === "pending") return div().size(7).flex_none().rounded(4).border_1().border_color(t.working);
+  if (item.ci === "pass") return div().size(6).flex_none().rounded(3).bg(t.ansi2);
+  if (item.ci === "fail") return div().size(6).flex_none().rounded(3).bg(t.ansi1);
+  return null;
+}
+
+// The tooltip's CI line, empty without CI.
+function ciLine(item) {
+  if (item.ci === "pending") return "\nChecks running";
+  if (item.ci === "pass") return "\nChecks passed";
+  if (item.ci === "fail") return `\nChecks failed${item.failed.length ? `: ${item.failed.map((f) => f.name).join(", ")}` : ""}`;
+  return "";
+}
+
+// The badge at the right of a space row: icon and number in the state's color, from a
+// hub entry `{ branch, items, error? }`. An empty element when there's nothing to show.
+export function prBadge(id, entry, t) {
+  const items = entry?.items ?? [];
+  if (!items.length) {
+    if (!entry?.error) return div();
+    // A hub entry names no host: glab's errors ("glab not installed", "GitLab unavailable…") say it.
+    const what = /glab|gitlab/i.test(entry.error) ? "MR" : "PR";
+    return div().id(`${id}-pr`).flex_none().text_size(11).text_color(t.dim)
+      .tooltip(`${what} unavailable: ${entry.error}`).child(`${what} ?`);
+  }
+  const item = items[0];
+  const look = item.look;
+  const shortcut = window().platform === "macos" ? "Cmd" : "Ctrl";
+  const stale = entry.error ? `\nMay be stale: ${entry.error}` : "";
+  const more = items.slice(1).map((p) => `\n+ ${p.repository}${sign(p)}${p.number} · ${p.title}`).join("");
+  const mark = ciMark(item, t);
+  const extra = `${look.ready ? "✓" : ""}${items.length > 1 ? `${look.ready ? " " : ""}+${items.length - 1}` : ""}`;
+  return h_flex()
+    .id(`${id}-pr`)
+    .flex_none()
+    .gap(3)
+    .items_center()
+    .text_size(11)
+    .text_color(t[look.tone] ?? t.dim)
+    .cursor_pointer()
+    .tooltip(`${item.repository}${sign(item)}${item.number} · ${look.label}${ciLine(item)}\n${item.title}${more}${stale}\n${shortcut}-click to open`)
+    // Stop modified presses so the row neither starts a drag nor selects.
+    .on_mouse_down("left", (event, cx) => {
+      if (linkClick(event)) cx.stop_propagation();
+    })
+    .on_mouse_up("left", (event, cx) => {
+      if (linkClick(event)) cx.stop_propagation();
+    })
+    .on_click((event, cx) => {
+      if (!linkClick(event)) return;
+      cx.stop_propagation();
+      cx.open_url(item.url);
+    })
+    .child(svg(`mods/status-hub/icons/${look.icon}.svg`).size(13).flex_none())
+    .child(`${sign(item)}${item.number}`)
+    .when(Boolean(mark), (el) => el.child(mark))
+    .when(Boolean(extra), (el) => el.child(extra));
+}
