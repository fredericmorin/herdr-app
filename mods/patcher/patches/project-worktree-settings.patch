+// Per-project settings in ~/.config/herdr-app/projects.json, keyed by the repo's main checkout:
+// { "projects": { "~/code/app": { "worktrees": { "directory": "~/worktrees/app", "setup": "direnv allow" } } } }
+// directory: where new worktrees go (<directory>/<branch>; default <root>/<repo>/<branch>).
+// setup: a sh script run in a new worktree's first terminal.
+// deleteBranch: Remove worktree also deletes the worktree's branch.
+// A top-level { "worktrees": { "deleteBranch": true } } is the default for every repo; a project's own wins.
+// The file's commented reference is kept by mods/patcher/projects.js.
+async function worktreeSettings(repo, root, userHome) {
+  const raw = await readTextFile(`${appHome()}/projects.json`);
+  let file = {};
+  if (raw !== null) {
+    try { file = JSON.parse(uncomment(raw)) ?? {}; } catch (error) { throw new Error(`projects.json: ${error.message}`); }
+  }
+  const projects = file.projects ?? {};
+  const fallback = file.worktrees?.deleteBranch;
+  if (fallback !== undefined && typeof fallback !== "boolean") throw new Error("projects.json: worktrees.deleteBranch must be true or false.");
+  const key = Object.keys(projects).find((k) => absolute(k, userHome) === repo.main);
+  const { directory, setup, deleteBranch } = (key && projects[key]?.worktrees) || {};
+  if (directory !== undefined && (typeof directory !== "string" || !/^([A-Za-z]:)?\//.test(absolute(directory, userHome))))
+    throw new Error(`projects.json: ${key}: worktrees.directory must be an absolute path or start with ~/.`);
+  if (setup !== undefined && typeof setup !== "string") throw new Error(`projects.json: ${key}: worktrees.setup must be a string.`);
+  if (deleteBranch !== undefined && typeof deleteBranch !== "boolean") throw new Error(`projects.json: ${key}: worktrees.deleteBranch must be true or false.`);
+  // Remove worktree has no root (it creates nothing), so it gets no dir.
+  return { dir: directory ? absolute(directory, userHome) : root && `${root}/${repo.name}`, setup: setup?.trim() ? setup : null, deleteBranch: (deleteBranch ?? fallback) === true };
+}
+// The branch a checkout has out (null when detached), and whether it has commits that
+// exist on no other branch and no remote: deleting it would lose them.
+async function branchOf(top, on) {
+  const name = await git(top, ["symbolic-ref", "--quiet", "--short", "HEAD"], on);
